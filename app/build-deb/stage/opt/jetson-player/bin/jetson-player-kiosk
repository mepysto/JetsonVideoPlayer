#!/usr/bin/env bash
# 키오스크(전용 기기) 모드 켜기/끄기
#   sudo jetson-player-kiosk enable [사용자] [미디어 경로]  → 다음 부팅부터 데스크톱 없이 플레이어만
#   sudo jetson-player-kiosk disable                        → 데스크톱으로 되돌림
#   jetson-player-kiosk status
set -e
CONF=/etc/default/jetson-player-kiosk
case "$1" in
  enable)
    [ "$EUID" -eq 0 ] || { echo "sudo로 실행하세요"; exit 1; }
    USER_NAME=${2:-${SUDO_USER:-jetson}}
    MEDIA=${3:-$(getent passwd "$USER_NAME" | cut -d: -f6)/Videos}
    sed -i "s|^KIOSK_USER=.*|KIOSK_USER=$USER_NAME|; s|^KIOSK_MEDIA=.*|KIOSK_MEDIA=$MEDIA|" "$CONF"
    usermod -aG video,render,audio,input "$USER_NAME" || true
    mkdir -p /etc/systemd/system/jetson-player-kiosk.service.d
    printf '[Service]\nUser=%s\n' "$USER_NAME" > /etc/systemd/system/jetson-player-kiosk.service.d/user.conf
    systemctl daemon-reload
    systemctl set-default multi-user.target
    systemctl enable jetson-player-kiosk.service
    echo "✅ 키오스크 모드를 켰습니다 (사용자 $USER_NAME, 미디어 $MEDIA). 재부팅하면 적용됩니다."
    ;;
  disable)
    [ "$EUID" -eq 0 ] || { echo "sudo로 실행하세요"; exit 1; }
    systemctl disable jetson-player-kiosk.service || true
    systemctl set-default graphical.target
    echo "✅ 키오스크 모드를 껐습니다. 재부팅하면 데스크톱으로 돌아갑니다."
    ;;
  status)
    systemctl is-enabled jetson-player-kiosk.service 2>/dev/null || true
    grep -E '^KIOSK_' "$CONF"
    ;;
  *) sed -n '2,5p' "$0"; exit 1 ;;
esac
